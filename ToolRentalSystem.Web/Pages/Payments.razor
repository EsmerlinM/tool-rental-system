@page "/payments"
@using ToolRentalSystem.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>Pagos</PageTitle>
<h3>Pagos</h3>
<button class="btn btn-primary mb-3" @onclick="IrACrear">
    <i class="bi bi-plus-lg"></i> Nuevo Pago
</button>

@if (payments == null)
{
    <p><em>Cargando...</em></p>
}
else if (payments.Count == 0)
{
    <p>No hay pagos registrados.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr><th>Id</th><th>Alquiler</th><th>Monto</th><th>Fecha</th><th>Recargo por mora</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var p in payments)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>Alquiler #@p.RentalId</td>
                    <td>@p.Amount.ToString("C")</td>
                    <td>@p.PaymentDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (p.HasLateFee)
                        {
                            <span class="badge bg-danger">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="() => IrAEditar(p.Id)">
                            <i class="bi bi-pencil-square"></i> Editar
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => PedirConfirmacion(p.Id)">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<ConfirmModal @ref="modal" Titulo="Eliminar pago" Mensaje="@mensajeModal" />

@code {
    private List<Payment>? payments;
    private ConfirmModal? modal;
    private string mensajeModal = "";

    protected override async Task OnInitializedAsync()
    {
        try { payments = await Http.GetFromJsonAsync<List<Payment>>("api/Payments"); }
        catch { payments = new List<Payment>(); }
    }

    private void IrACrear() => Navigation.NavigateTo("/payments/new");
    private void IrAEditar(int id) => Navigation.NavigateTo($"/payments/edit/{id}");

    private void PedirConfirmacion(int id)
    {
        mensajeModal = $"¿Seguro que deseas eliminar el pago #{id}?";
        modal?.Mostrar(() => Eliminar(id));
    }

    private async Task Eliminar(int id)
    {
        var response = await Http.DeleteAsync($"api/Payments/{id}");
        if (response.IsSuccessStatusCode) payments?.RemoveAll(p => p.Id == id);
        StateHasChanged();
    }
}