@page "/"
@using ToolRentalSystem.Web.Models
@inject HttpClient Http

<PageTitle>Inicio</PageTitle>

<h3>Panel de Control</h3>
<p class="text-muted">Resumen general del sistema de alquiler de herramientas.</p>

<div class="row mt-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background-color:#6b21a8;">
            <div class="card-body">
                <h6 class="card-title">Herramientas</h6>
                <h2>@(totalTools?.ToString() ?? "...")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background-color:#1e1e2f;">
            <div class="card-body">
                <h6 class="card-title">Clientes</h6>
                <h2>@(totalCustomers?.ToString() ?? "...")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background-color:#6b21a8;">
            <div class="card-body">
                <h6 class="card-title">Alquileres activos</h6>
                <h2>@(activeRentals?.ToString() ?? "...")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background-color:#1e1e2f;">
            <div class="card-body">
                <h6 class="card-title">Pagos registrados</h6>
                <h2>@(totalPayments?.ToString() ?? "...")</h2>
            </div>
        </div>
    </div>
</div>

@code {
    private int? totalTools;
    private int? totalCustomers;
    private int? activeRentals;
    private int? totalPayments;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tools = await Http.GetFromJsonAsync<List<Tool>>("api/Tools");
            totalTools = tools?.Count ?? 0;

            var customers = await Http.GetFromJsonAsync<List<Customer>>("api/Customers");
            totalCustomers = customers?.Count ?? 0;

            var rentals = await Http.GetFromJsonAsync<List<Rental>>("api/Rentals");
            activeRentals = rentals?.Count(r => !r.IsReturned) ?? 0;

            var payments = await Http.GetFromJsonAsync<List<Payment>>("api/Payments");
            totalPayments = payments?.Count ?? 0;
        }
        catch
        {
            totalTools = totalCustomers = activeRentals = totalPayments = 0;
        }
    }
}