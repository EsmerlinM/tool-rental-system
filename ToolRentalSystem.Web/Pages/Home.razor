@page "/"
@using ToolRentalSystem.Web.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Inicio</PageTitle>

<h3>Bienvenido a ToolRentalSystem</h3>
<p class="text-muted">Aquí tienes un resumen general de tu sistema de alquiler de herramientas.</p>

<div class="row mt-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white dashboard-card" style="background-color:#6b21a8;" @onclick='() => Navigation.NavigateTo("/tools")'>
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-tools fs-1 me-3"></i>
                <div>
                    <h6 class="card-title mb-0">Herramientas</h6>
                    <h2 class="mb-0">@(totalTools?.ToString() ?? "...")</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white dashboard-card" style="background-color:#1e1e2f;" @onclick='() => Navigation.NavigateTo("/customers")'>
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-people-fill fs-1 me-3"></i>
                <div>
                    <h6 class="card-title mb-0">Clientes</h6>
                    <h2 class="mb-0">@(totalCustomers?.ToString() ?? "...")</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white dashboard-card" style="background-color:#6b21a8;" @onclick='() => Navigation.NavigateTo("/rentals")'>
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-calendar-check-fill fs-1 me-3"></i>
                <div>
                    <h6 class="card-title mb-0">Alquileres activos</h6>
                    <h2 class="mb-0">@(activeRentals?.ToString() ?? "...")</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white dashboard-card" style="background-color:#1e1e2f;" @onclick='() => Navigation.NavigateTo("/payments")'>
            <div class="card-body d-flex align-items-center">
                <i class="bi bi-cash-coin fs-1 me-3"></i>
                <div>
                    <h6 class="card-title mb-0">Pagos registrados</h6>
                    <h2 class="mb-0">@(totalPayments?.ToString() ?? "...")</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<p class="text-muted mt-2"><i class="bi bi-info-circle"></i> Haz clic en cualquier tarjeta para ir directo a esa sección.</p>

@code {
    private int? totalTools;
    private int? totalCustomers;
    private int? activeRentals;
    private int? totalPayments;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tools = await Http.GetFromJsonAsync<List<Tool>>("api/Tools");
            totalTools = tools?.Count ?? 0;

            var customers = await Http.GetFromJsonAsync<List<Customer>>("api/Customers");
            totalCustomers = customers?.Count ?? 0;

            var rentals = await Http.GetFromJsonAsync<List<Rental>>("api/Rentals");
            activeRentals = rentals?.Count(r => !r.IsReturned) ?? 0;

            var payments = await Http.GetFromJsonAsync<List<Payment>>("api/Payments");
            totalPayments = payments?.Count ?? 0;
        }
        catch
        {
            totalTools = totalCustomers = activeRentals = totalPayments = 0;
        }
    }
}